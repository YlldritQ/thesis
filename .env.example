# Project configuration — copy to `.env` and edit.
# Every variable is optional; values shown are the defaults.

# ---------------------------------------------------------- paths
# THESIS_PROJECT_ROOT=/path/to/repo
# THESIS_DATA_DIR=${THESIS_PROJECT_ROOT}/data
# THESIS_DOCS_DIR=${THESIS_PROJECT_ROOT}/docs

# ---------------------------------------------------------- logging
THESIS_LOG_LEVEL=INFO
THESIS_LOG_FORMAT=console     # or "json" in production

# ---------------------------------------------------------- ingestion
# THESIS_OCDS_PUBLICATION_URL=https://data.open-contracting.org/en/publication/115/download?name=full.jsonl.gz
# THESIS_OCDS_REQUEST_TIMEOUT_S=600

# ---------------------------------------------------------- modelling
THESIS_RANDOM_SEED=7
THESIS_ISO_FOREST_N_ESTIMATORS=300
THESIS_ISO_FOREST_CONTAMINATION=0.05
THESIS_LOF_N_NEIGHBORS=30
THESIS_LOF_CONTAMINATION=0.05
THESIS_ELLIPTIC_ENVELOPE_CONTAMINATION=0.05
THESIS_OCSVM_NU=0.05
THESIS_OCSVM_SUBSAMPLE_SIZE=10000
THESIS_HGB_N_ESTIMATORS=300
THESIS_HGB_MAX_DEPTH=4
THESIS_CV_FOLDS=5
THESIS_BOOTSTRAP_SAMPLES=20
THESIS_RULE_LABEL_THRESHOLD=0.4

# ---------------------------------------------------------- thresholds
THESIS_RULE_SCORE_REVIEW_THRESHOLD=0.5
THESIS_RULE_SCORE_PRIORITY_THRESHOLD=0.7
THESIS_ENSEMBLE_SCORE_REVIEW_THRESHOLD=0.5
THESIS_MINIMUM_MODELS_AGREEING_FOR_HIGH_CONFIDENCE=3

# ---------------------------------------------------------- behaviour
THESIS_FAIL_FAST_ON_DQ=false
THESIS_WRITE_LINEAGE_SIDECARS=true
